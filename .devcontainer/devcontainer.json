{
  "name": "ETL for AI Engineering",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postCreateCommand": "python scripts/setup_classroom.py",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Dagster UI", "onAutoForward": "openBrowser" } },
  "containerEnv": { "DAGSTER_HOME": "/workspaces/${localWorkspaceFolderBasename}/.dagster_home" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "innoverio.vscode-dbt-power-user", "RandomFractalsInc.duckdb-sql-tools"]
    }
  }
}
